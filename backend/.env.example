# Prosecuto backend environment — copy to .env and fill in.
# .env is gitignored. NEVER commit real keys.

# --- Secrets ---
NVIDIA_API_KEY= 
TAVILY_API_KEY= 
ADMIN_TOKEN=

# --- Infra ---
REDIS_URL=redis://localhost:6379/0
CHROMA_COLLECTION=prosecuto
# CHROMA_PERSIST_DIR / CORPUS_DIR default to backend/data/{chroma,corpus}.
# Uncomment to override (Docker compose sets these to /app/data/...):
# CHROMA_PERSIST_DIR=./backend/data/chroma
# CORPUS_DIR=./backend/data/corpus

# --- NVIDIA NIM models ---
NIM_LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NIM_RERANK_MODEL=nv-rerank-qa-mistral-4b:1

# --- Voice / avatar gRPC endpoints ---
RIVA_ASR_ENDPOINT=grpc://localhost:50051
RIVA_TTS_ENDPOINT=grpc://localhost:50052
A2F_ENDPOINT=grpc://localhost:52000

# --- Behaviour ---
SESSION_TTL_HOURS=24
MAX_RAG_RETRIES=2
TAVILY_MAX_SOURCES=5
